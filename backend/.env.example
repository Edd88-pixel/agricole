# Server
PORT=4000
NODE_ENV=development

# Supabase core configuration (never expose service role key on the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Storage buckets (match your Supabase project)
SUPABASE_STORAGE_BUCKET_DIAGNOSIS=diagnosis-images
SUPABASE_STORAGE_BUCKET_REPORTS=diagnosis-reports
SUPABASE_STORAGE_BUCKET_PROFILE=profile-avatars
SUPABASE_STORAGE_BUCKET_KNOWLEDGE=
STORAGE_BUCKET_DIAGNOSIS=diagnosis-images
STORAGE_BUCKET_PROFILE=profile-avatars

# Edge Functions names (as deployed in Supabase)
SUPABASE_FUNCTION_DIAGNOSIS=https://your-project.supabase.co/functions/v1/dynamic-handler
SUPABASE_FUNCTION_KNOWLEDGE=https://your-project.supabase.co/functions/v1/knowledge-chat
